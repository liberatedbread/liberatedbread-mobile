<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Not just for the Dart VM service, which is why it is here and not only
	     in DebugProfile.entitlements. Under the App Sandbox this is what lets
	     the app BIND a listening socket, and the mDNS half of the Wi-Fi scan
	     does exactly that: `multicast_dns` binds UDP 5353 and joins
	     224.0.0.251 rather than going through Bonjour. Without it that bind
	     throws, mDNS reports `failed`, and a release build discovers only what
	     SSDP happens to find. When SSDP also finds nothing, scanFailureFor()
	     reads the silence as a denied local-network permission and says so.

	     The SSDP half is unaffected: it binds an ephemeral port and receives
	     unicast replies to its own M-SEARCH, which network.client already
	     covers. So the symptom is a release-only, transport-specific hole,
	     invisible in `flutter run -d macos`. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Required by flutter_secure_storage 9.x under the App Sandbox: without a
	     keychain-access-groups entitlement (an empty array is enough — it makes
	     the app use its own default access group) every SecItem* call fails with
	     errSecMissingEntitlement (-34018), so the Home Assistant token can be
	     neither stored nor read. See lib/services/secure_settings_store.dart. -->
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>
