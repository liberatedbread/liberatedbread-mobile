# APK Monitor Configuration
# Copy to config.env and fill in values.

# ── API Keys ──────────────────────────────────────────────
# Claude API (Anthropic)
ANTHROPIC_API_KEY=""
# OpenAI API
OPENAI_API_KEY=""

# ── Model Configuration ──────────────────────────────────
CLAUDE_MODEL="claude-sonnet-4-20250514"
OPENAI_MODEL="gpt-4o"
# Local model served via an OpenAI-compatible API (e.g. ollama, vllm, llama.cpp)
LOCAL_MODEL="qwen2.5-coder:32b"
LOCAL_MODEL_BASE_URL="http://localhost:11434/v1"
LOCAL_MODEL_API_KEY="ollama"   # ollama doesn't need a real key

# ── Paths ─────────────────────────────────────────────────
# Root of opengreeniot-protocol-docs repo
PROTOCOL_DOCS_ROOT=""          # auto-detected if empty
# Directory where reverse-engineering transcripts are saved (separate repo)
TRANSCRIPTS_REPO=""            # e.g. /home/user/re-transcripts
# Working directory for APKs and intermediate artifacts
WORKSPACE_DIR=""               # defaults to $PROTOCOL_DOCS_ROOT/workspace

# ── APK Source ────────────────────────────────────────────
APKEEP_SOURCE="apk-pure"
# For google-play: set APKEEP_EMAIL and APKEEP_AAS_TOKEN
APKEEP_EMAIL=""
APKEEP_AAS_TOKEN=""

# ── Discovery ─────────────────────────────────────────────
# Comma-separated categories to search APKPure for new IoT apps
APK_SEARCH_CATEGORIES="bluetooth,ble,smart home,led controller,iot,smart light,smart plug"
# Max new APKs to download per run
MAX_NEW_APKS_PER_RUN=10

# ── Git / Merge ───────────────────────────────────────────
# GitHub org/repo for protocol-docs (used for branch ops)
PROTOCOL_DOCS_REMOTE="origin"
# Branch prefix for RE agent branches
RE_BRANCH_PREFIX="re-agent"
# Minimum votes required to auto-merge (out of 3 agents)
MIN_VOTES_TO_MERGE=2
