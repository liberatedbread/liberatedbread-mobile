<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: render with Skia instead of Impeller. CI's
         emulator (SwiftShader GPU, which also advertises a SwiftShader
         Vulkan device) hangs creating the Impeller surface before Dart ever
         runs, so `flutter test integration_test` waits forever for a VM
         service that never appears. Release builds keep the engine default.
    -->
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
