# Uncomment this line to define a global platform for your project.
# Left commented, matching Flutter's template: with no platform declared here,
# flutter_ios_podfile_setup takes it from the Runner target's
# IPHONEOS_DEPLOYMENT_TARGET, so there is one place to change instead of two.
# Keep the version here in step with that setting anyway — a stale number in a
# commented line is what a reader copies when they do uncomment it.
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # If you ever route an iOS permission through permission_handler, define the
    # matching PERMISSION_* macro here. permission_handler_apple compiles every
    # permission strategy out by default (PermissionHandlerEnums.h defaults each
    # macro to 0), and the compiled-out strategy answers *every* request with
    # PermissionStatusPermanentlyDenied — a silent, device-only failure that no
    # simulator build or mock-mode test can catch.
    #
    # Bluetooth deliberately does NOT need this today: lib/services/
    # real_ble_service.dart lets CoreBluetooth raise its own prompt on first
    # scan, so nothing asks permission_handler for it. See the comment in
    # requestPermissions() before changing that.
    #
    #   config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
    #   config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += ['PERMISSION_BLUETOOTH=1']
  end
end
