<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App Store distribution: signed IPA for upload to App Store Connect.      -->
  <!-- teamID = Pigs Can Fly Labs LLC (the org team that owns the App ID and    -->
  <!-- the bundle id ca.pigscanfly.*). NOTE: the Mac's existing signing cert is  -->
  <!-- the *individual* "Holden Karau" team (B6SUD26678) — you need a            -->
  <!-- Distribution cert + App Store profile issued under THIS org team instead. -->
  <!-- provisioningProfiles maps the bundle id -> the App Store DISTRIBUTION    -->
  <!-- profile NAME. That profile must be created in the Apple Developer portal -->
  <!-- AFTER the com.apple.developer.networking.multicast entitlement is        -->
  <!-- granted and enabled on the App ID, or signing will fail. Rename the      -->
  <!-- string below to whatever you call the profile.                          -->
  <key>method</key>
  <string>app-store-connect</string>

  <key>teamID</key>
  <string>GQ358PSWM3</string>

  <key>signingStyle</key>
  <string>manual</string>

  <key>provisioningProfiles</key>
  <dict>
    <key>ca.pigscanfly.liberatedbread</key>
    <string>Liberated Bread App Store</string>
  </dict>

  <!-- Upload dSYMs so App Store Connect can symbolicate crash reports. -->
  <key>uploadSymbols</key>
  <true/>

  <key>stripSwiftSymbols</key>
  <true/>

  <!-- Let App Store Connect manage bitcode/thinning for the shipped build. -->
  <key>uploadBitcode</key>
  <false/>
</dict>
</plist>
