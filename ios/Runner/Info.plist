<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Liberated Bread</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Liberated Bread</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Liberated Bread needs Bluetooth to communicate with your IoT devices.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Liberated Bread needs Bluetooth to communicate with your IoT devices.</string>
	<!-- No NSLocationWhenInUseUsageDescription: iOS BLE needs no location, and
	     the only location request in the app is Android-only
	     (RealBleService.requestPermissions, inside `if (Platform.isAndroid)`).
	     A location purpose string with no matching location-API use is a
	     Guideline 5.1.1 review flag, so it is deliberately absent here.
	     test/platform/ios_info_plist_test.dart asserts the absence, so this
	     decision survives even if the comment is lost again. -->
	<!-- iOS 14+ will not deliver mDNS answers for a service type that is not
	     declared here, and fails silently when one is missing. The generic
	     DNS-SD meta-query is what lets the scan enumerate service types it has
	     no spec for; the rest are the types this app's device specs name.
	     Regenerate with ./scripts/regen-bonjour-services.sh; the list is
	     checked against the vendored catalogue by
	     test/platform/ios_bonjour_catalogue_test.dart. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_adb-tls-connect._tcp</string>
		<string>_adb-tls-pairing._tcp</string>
		<string>_adb._tcp</string>
		<string>_airplay._tcp</string>
		<string>_androidtvremote2._tcp</string>
		<string>_ankivector._tcp</string>
		<string>_aqara._tcp</string>
		<string>_arsdk._udp</string>
		<string>_dyson_mqtt._tcp</string>
		<string>_enphase-envoy._tcp</string>
		<string>_esphomelib._tcp</string>
		<string>_googlecast._tcp</string>
		<string>_hap._tcp</string>
		<string>_home-assistant._tcp</string>
		<string>_http._tcp</string>
		<string>_hue._tcp</string>
		<string>_ipp._tcp</string>
		<string>_ipps._tcp</string>
		<string>_leap._tcp</string>
		<string>_lutron._tcp</string>
		<string>_matter._tcp</string>
		<string>_matterc._udp</string>
		<string>_miio._udp</string>
		<string>_moonraker._tcp</string>
		<string>_osc._udp</string>
		<string>_pdl-datastream._tcp</string>
		<string>_philipstv_rpc._tcp</string>
		<string>_philipstv_s_rpc._tcp</string>
		<string>_printer._tcp</string>
		<string>_rabbitair._udp</string>
		<string>_raop._tcp</string>
		<string>_services._dns-sd._udp</string>
		<string>_slimprotocol._tcp</string>
		<string>_smartthings-hedge._tcp</string>
		<string>_smartthings._tcp</string>
		<string>_snapmaker._tcp</string>
		<string>_soundtouch._tcp</string>
		<string>_spotify-connect._tcp</string>
		<string>_viziocast._tcp</string>
		<string>_wled._tcp</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Liberated Bread prints the photos you choose on your label printer.</string>
	<key>NSCameraUsageDescription</key>
	<string>Liberated Bread prints the photos you take on your label printer.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Liberated Bread finds IoT devices on your Wi-Fi network, and connects to your Home Assistant server.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
